{
  "compilerOptions": {
    "strict": false,
    "outDir": "./lib",
    "target": "ES2020",
    "module": "ES2020",

    // enabling esModuleInterop will cause all project using lonad to have to use esModuleInterop
    // as such it is disabled by default,
    "esModuleInterop": true,

    "allowSyntheticDefaultImports":true,
    "moduleResolution": "Node",
    "declaration": true,
    "types": ["node", "jest"],
  },

  "include": ["source/**/*"],

  "exclude": [
    "**/*.spec.ts",
    "lib/**/*",
    "bundle/**/*",
    "node_modules/**/*",
  ]
}
